# =============================================================================
# Hermès — environment template. Copy to .env and fill in.
# =============================================================================

# --- Runtime mode ----------------------------------------------------------
# stage_0_paper | stage_1_micro | stage_2_normal | stage_3_perps
HERMES_STAGE=stage_0_paper
HERMES_DATA_DIR=/data
HERMES_LOG_LEVEL=INFO
HERMES_TZ=America/Toronto
# API key protecting /tick, /status, /learn/* (header: x-api-key). Empty = open
# (paper only). MANDATORY before any live stage — generate a long random value.
HERMES_API_KEY=

# --- FALLBACK LLM (used only if DeepSeek, the SETTLED primary, is unreachable) -
# DeepSeek V4 is the primary brain (DEEPSEEK_API_KEY) — not negotiable. These are
# the fallback only: an independent OpenAI-compatible CLOUD endpoint reached direct
# over the internet (no Tailscale, no Mac). Operator's choice: OpenRouter serving
# inclusionai/ring-2.6-1t. Operator adds the OpenRouter key.
LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=inclusionai/ring-2.6-1t
LLM_PRIMARY_API_KEY=

LLM_SECONDARY_BASE_URL=https://openrouter.ai/api/v1
LLM_SECONDARY_MODEL=inclusionai/ring-2.6-1t
LLM_SECONDARY_API_KEY=

# Optional remote escalation for hard reasoning (leave blank to disable).
LLM_ESCALATION_BASE_URL=https://api.deepseek.com/v1
LLM_ESCALATION_MODEL=deepseek-v4-pro
LLM_ESCALATION_API_KEY=

# --- TRM verifier ----------------------------------------------------------
TRM_ENABLED=true
TRM_CHECKPOINT=/data/trm/latest.pt
TRM_CONFIDENCE_FLOOR=0.55

# --- Exchanges -------------------------------------------------------------
# EXCHANGE_PRIMARY is now yaml-driven (config/default.yaml data_venue: binanceusdm).
# Uncomment ONLY to override the venue: # EXCHANGE_PRIMARY=binanceusdm
EXCHANGE_BACKUP=bybit
# Venue used by paper mode for reference prices. Must list our USDC-quoted
# universe. Defaults to Kraken (lists BTC/USDC, ETH/USDC, SOL/USDC). Binance
# is NOT a valid choice — it only lists USDT pairs at the spot tier we want.
# PAPER_PRICE_VENUE now defaults to the data venue (binanceusdm). Set only to override.
# PAPER_PRICE_VENUE=binanceusdm

# Hyperliquid (testnet by default; flip to false only at stage 1+)
HL_TESTNET=true
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=

# Bybit backup (optional)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Data sources ----------------------------------------------------------
CRYPTOPANIC_TOKEN=
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=

# --- Infra -----------------------------------------------------------------
REDIS_URL=redis://hermes-redis:6379/0
DATABASE_URL=sqlite+aiosqlite:////data/hermes.db
VECTOR_DIR=/data/chroma

# (Tailscale removed 2026-06-25: the agent is a single self-contained container
# reaching DeepSeek + the cloud fallback over the internet — no sidecar, no Mac.)

# --- Universe + sizing -----------------------------------------------------
HERMES_BANKROLL_USD=100
# HERMES_UNIVERSE is now yaml-driven (config/default.yaml universe:).
# Uncomment ONLY to override the universe: # HERMES_UNIVERSE=BTC/USDT:USDT,ETH/USDT:USDT
HERMES_MAX_OPEN_POSITIONS=3
HERMES_DAILY_LOSS_KILL_PCT=2.0
